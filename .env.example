# Server-only. Copy to .env.local and restart npm run dev. Never use VITE_* for keys.
#
# "AI làm đẹp bài giảng" with a Google AI Studio key (https://aistudio.google.com/apikey):
# LESSON_AI_PROVIDER=gemini
# LESSON_AI_API_KEY=
# LESSON_AI_MODEL=gemini-3.8-flash
# LESSON_AI_IMAGE_MODEL=gemini-nano-banana-2.1
# LESSON_AI_THINKING=low   (minimal, low, medium, high; "off" to send none)
#
# ...or Claude for the text (https://console.anthropic.com), Gemini only for pictures:
# LESSON_AI_PROVIDER=anthropic
# LESSON_AI_API_KEY=
# LESSON_AI_MODEL=claude-sonnet-5-5   (or claude-haiku-5-5, cheaper)
# LESSON_AI_GEMINI_KEY=               (optional, needed to draw pictures)
#
# Lesson-plan (Word) analysis with OpenAI:
LESSON_AI_PROVIDER=openai
LESSON_AI_MODEL=gpt-4.1-mini
LESSON_AI_API_KEY=
